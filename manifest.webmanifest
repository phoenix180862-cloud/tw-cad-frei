{
  "name": "TW-CAD – Planen, Fliesen, 3D",
  "short_name": "TW-CAD",
  "description": "Kostenloses CAD für Grundriss, Fliesenplanung, 3D und Plandruck – ein Geschenk von Thomas Willwacher Fliesenlegermeister e.K. (www.thomas-willwacher.de)",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#12161b",
  "theme_color": "#12161b",
  "lang": "de",
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [{ "action": "./index.html", "accept": { "application/json": [".twcad"], "image/vnd.dxf": [".dxf"] } }]
}
